# Supabase 프로젝트 설정 (Dashboard → Project Settings → Data API / API Keys)
# EXPO_PUBLIC_ 접두사가 붙은 값만 앱 번들에 포함됩니다.
# anon key 는 공개되어도 되는 값입니다. 실제 보호는 RLS 가 합니다.
# ⚠️ service_role key 는 절대 이 파일에 넣지 마세요. 앱에 박히면 DB 전체가 열립니다.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 선택: 이메일 인증 단계를 건너뛴다 (개발 빌드 전용).
# verify-email Edge Function 없이 가입 흐름을 시험할 때만 켠다.
# EXPO_PUBLIC_SKIP_EMAIL_VERIFY=true
